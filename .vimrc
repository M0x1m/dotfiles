source $VIMRUNTIME/vimrc_example.vim
set nu
set relativenumber
set ai
set cin
set shiftwidth=4
set tabstop=4
set smarttab
set smartindent
set smartcase
set expandtab
set nobackup
syntax on
"colorscheme desert
colorscheme koehler
cnoreabbrev rt %s/\s\+$//

set guifont=ubuntu\ mono\ 18
set guioptions=
